APP_NAME=どでん給与システム
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 本番で Log::error 等も Sentry に送る場合: single,sentry（DSN 未設定時は sentry チャンネルは実質 no-op）
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sentry（https://sentry.io）未設定時は送信しない。本番の .env のみ DSN を設定推奨
SENTRY_LARAVEL_DSN=
# エラー通知のみなら 0（パフォーマンストレース無効）
SENTRY_TRACES_SAMPLE_RATE=0

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Chatwork API（サービス連携で発行したトークン。前後の引用符は不要）
# 変更後は php artisan config:clear または config:cache の再生成を推奨
CHATWORK_API_TOKEN=

# 管理ログインページのパス（/admin/ の後に続く文字列）
# 未設定: management-console、本番は推測されにくい文字列を設定してください
# 例: ADMIN_LOGIN_PATH=fl3x-9k2m
# 未認証で /admin/dashboard 等にアクセスすると 404 が返ります（ログイン画面へはリダイレクトしません）
ADMIN_LOGIN_PATH=

# IP制限（打刻ページ・打刻API のみ適用）
# カンマ区切りで複数設定可能。空の場合は制限なし（開発環境用）
# 例: ALLOWED_IPS=1.2.3.4,5.6.7.8,192.168.0.0/24
ALLOWED_IPS=

FEATURE_DEPARTMENT=true

VITE_APP_NAME="${APP_NAME}"

# フロントの URL プレフィックス（Vite ビルド時に埋め込む）
# 例: https://example.com/dev でアプリを見るときだけ /dev。本番が / なら空。
# サブドメインのドキュメントルートが既に public_html/dev のときは URL に /dev が付かないため、空のまま。
VITE_BASE_PATH=
